# Copy to .env and supply deployment-owned secrets and approved resource paths.
POSTGRES_PASSWORD=replace-with-secret-manager-value
REDIS_PASSWORD=replace-with-secret-manager-value
CACHE_ENCRYPTION_KEY=replace-with-fernet-key
MODEL_CACHE_PATH=./.model-cache
POSTPROCESSOR_RESOURCES_PATH=./deployment/postprocessing
OCR_CONFIG__PROVIDER_VERSION=contract-1.0.0
OCR_CONFIG__PROMPT=Transcribe the medical document exactly, preserving reading order.
OCR_CONFIG__PROMPT_VERSION=deployment-approved-v1
OCR_CONFIG__CONFIDENCE_CALIBRATION_VERSION=token-probability-uncalibrated-v1
POSTPROCESSOR_CONFIG__PROVIDER_VERSION=contract-1.0.0
POSTPROCESSOR_CONFIG__DICTIONARY_VERSION=deployment-approved-v1
POSTPROCESSOR_CONFIG__ABBREVIATION_DICTIONARY_VERSION=deployment-approved-v1
POSTPROCESSOR_CONFIG__RULE_VERSION=deployment-approved-v1
